# Neon PostgreSQL — use a separate Neon database from Aura Fresh
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/pixeltech?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
APP_FRONTEND_BASE_URL=http://localhost:3000

# Cloudinary — product images
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=pixel-tech/products

# Optional — first admin account (only created if username does not exist)
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=pixel-admin

# Optional — Stripe return URLs
# Web:
# APP_CHECKOUT_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
# APP_CHECKOUT_CANCEL_URL=http://localhost:3000/cart
# Deep links (Pixel Tech):
# APP_CHECKOUT_SUCCESS_URL=pixeltech://payment/success?session_id={CHECKOUT_SESSION_ID}
# APP_CHECKOUT_CANCEL_URL=pixeltech://cart
